# Optional: Google Gemini API Key for live multi-agent streaming
# If omitted, CogniFlow seamlessly runs with the built-in high-fidelity autonomous mock engine
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Selection: gemini-2.5-flash or gemini-2.5-pro
VITE_DEFAULT_MODEL=gemini-2.5-flash
